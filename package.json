{
  "name": "conscious",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Conscious: a personal life assistant you text on iMessage and WhatsApp",
  "homepage": "https://github.com/luisbeqja/conscious#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisbeqja/conscious.git"
  },
  "bugs": {
    "url": "https://github.com/luisbeqja/conscious/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "chat": "tsx --env-file-if-exists=.env src/main.ts",
    "photon": "tsx --env-file-if-exists=.env src/photon.ts",
    "app": "tsx --env-file-if-exists=.env src/app.ts",
    "skills:import": "tsx scripts/import-skill.ts",
    "computer:check": "tsx --env-file-if-exists=.env scripts/check-computer.ts",
    "italy:download": "uv run scripts/download-italia-fonti.py",
    "italy:index": "tsx --env-file-if-exists=.env scripts/build-italy-index.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint ./src/ ./test/",
    "format": "biome format --write ./src/ ./test/",
    "ci": "biome ci ./src/ ./test/"
  },
  "dependencies": {
    "@e2b/desktop": "2.5.0",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@photon-ai/whatsapp-business": "0.3.2",
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1",
    "@spectrum-ts/whatsapp-business": "12.10.1",
    "croner": "^9.1.0",
    "e2b": "^2.58.0",
    "imapflow": "^1.7.8",
    "mailparser": "^3.12.4",
    "playwright-core": "1.64.1",
    "typebox": "1.3.27",
    "ws": "8.22.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
