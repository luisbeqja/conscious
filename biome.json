{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "root": true,
  "vcs": { "enabled": true, "clientKind": "git", "defaultBranch": "main" },
  "formatter": { "indentStyle": "space", "indentWidth": 4, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" } },
  "linter": {
    "rules": {
      "recommended": true,
      "style": { "noDefaultExport": "error" },
      "suspicious": { "noExplicitAny": "error" }
    }
  }
}
