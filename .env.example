# Model: any pi-ai provider, with its usual key variable. See "Choose your model" in the README.
CONSCIOUS_MODEL_PROVIDER=anthropic
CONSCIOUS_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# For example, Mistral:
#   CONSCIOUS_MODEL_PROVIDER=mistral  CONSCIOUS_MODEL=mistral-large-latest  MISTRAL_API_KEY=...
# Or a model on your own machine, through any OpenAI-compatible server (Ollama, LM Studio, vLLM):
#   CONSCIOUS_MODEL_PROVIDER=local  CONSCIOUS_MODEL=qwen3:8b  CONSCIOUS_MODEL_BASE_URL=http://localhost:11434/v1
CONSCIOUS_MODEL_BASE_URL=
CONSCIOUS_MODEL_API_KEY=

# Reminders and "today" are read in this timezone. Defaults to the machine's.
CONSCIOUS_TIMEZONE=Europe/Rome

# Photon Spectrum (`pnpm photon`): iMessage and WhatsApp. Project id and secret from app.photon.codes
# (the SPECTRUM_PROJECT_ID / SPECTRUM_PROJECT_SECRET lines it gives you work too).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_PLATFORMS=imessage,whatsapp
# Only these senders can talk to Conscious, comma separated, exactly as Photon reports them
# (phone numbers in E.164 like +393331234567, or an Apple ID email).
CONSCIOUS_ALLOWED_USERS=

# Conscious's computer: one E2B sandbox per user, where its memory, files and the conversation
# live, and where its shell and file tools run. "none" keeps everything in this process.
CONSCIOUS_SANDBOX=none
E2B_API_KEY=
# The E2B EU cluster (ask E2B support for it), or your own E2B (https://github.com/e2b-dev/infra).
# Empty means E2B's default cloud, which runs in the US.
E2B_DOMAIN=
CONSCIOUS_SANDBOX_TEMPLATE=base
# The sandbox pauses after this long without a message and resumes on the next; files survive.
CONSCIOUS_SANDBOX_IDLE_MINUTES=10
# Off by default: without internet the computer cannot act in the world for the user.
CONSCIOUS_SANDBOX_INTERNET=false

# MCP servers from mcp/ to connect to, comma separated, or "none". Empty means the catalog's
# defaults: Kiwi.com flights and trivago hotels, which need no account. Calls run from this host.
CONSCIOUS_MCP_SERVERS=

# Web search, run from this host. Empty picks: Brave with BRAVE_API_KEY, SearXNG with
# CONSCIOUS_SEARXNG_URL (your own instance, JSON output on), else DuckDuckGo (no key, throttles heavy use).
CONSCIOUS_SEARCH=
BRAVE_API_KEY=
CONSCIOUS_SEARXNG_URL=

# The Vault: the private page where users save account tokens (GitHub, …) instead of pasting them in the chat.
# Links point to CONSCIOUS_PUBLIC_URL; for a phone, that is an https tunnel or proxy to the port.
CONSCIOUS_VAULT_PORT=8787
CONSCIOUS_PUBLIC_URL=
# Optional: 32 random bytes, base64 (`openssl rand -base64 32`). Without it, a key is created once in
# .conscious/vault.key. In production, keep the key out of the data folder.
CONSCIOUS_VAULT_KEY=
# Where the Vault, plugins and installs are saved so they survive a restart. Default: ./.conscious
CONSCIOUS_DATA_DIR=
