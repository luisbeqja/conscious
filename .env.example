# Model. Credentials come from the provider's usual environment.
CONSCIOUS_MODEL_PROVIDER=anthropic
CONSCIOUS_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta). The webhook is served at /webhooks/whatsapp.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Only these numbers (E.164 without +, comma separated) can talk to Conscious.
CONSCIOUS_ALLOWED_NUMBERS=

# Your timezone: reminders and "today" are read in it.
CONSCIOUS_TIMEZONE=Europe/Rome

PORT=8100
